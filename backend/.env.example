# Kairos Spring Boot — Environment Variables
# Copy to .env for local development. In production, set these as actual environment variables.

# Server
PORT=8080

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/kairos_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Security / JWT (REQUIRED in production — generate a secure 64+ hex char key)
# Example generation: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (your deployed frontend URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
